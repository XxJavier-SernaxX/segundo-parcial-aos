# ==============================================================================
# HUELLAS DE ESPERANZA - VARIABLES DE ENTORNO
# ==============================================================================

# URLs de los Microservicios SOA
API_MASCOTAS_URL=http://127.0.0.1:8001
API_ADOPCIONES_URL=http://127.0.0.1:8002

# Conexión a Base de Datos PostgreSQL / Supabase
# Obtén estas credenciales en: https://app.supabase.com -> Project Settings -> Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Supabase Connection String directo (opcional para pooler)
# SUPABASE_DB_URL=postgresql://postgres.xxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Modo Offline / Mock Store en Memoria (True si aún no conectas credenciales Supabase)
USE_IN_MEMORY_FALLBACK=true
