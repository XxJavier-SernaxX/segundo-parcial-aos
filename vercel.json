{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "public",
      "framework": "other"
    },
    "api-adopciones": {
      "root": "api-adopciones",
      "framework": "fastapi",
      "bindings": [
        {
          "type": "service",
          "service": "api-mascotas",
          "format": "url",
          "env": "API_MASCOTAS_URL"
        }
      ]
    },
    "api-mascotas": {
      "root": "api-mascotas",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/mascotas/(.*)",
      "destination": {
        "service": "api-mascotas"
      }
    },
    {
      "source": "/mascotas",
      "destination": {
        "service": "api-mascotas"
      }
    },
    {
      "source": "/api/v1/mascotas/(.*)",
      "destination": {
        "service": "api-mascotas"
      }
    },
    {
      "source": "/api/v1/mascotas",
      "destination": {
        "service": "api-mascotas"
      }
    },
    {
      "source": "/solicitudes/(.*)",
      "destination": {
        "service": "api-adopciones"
      }
    },
    {
      "source": "/solicitudes",
      "destination": {
        "service": "api-adopciones"
      }
    },
    {
      "source": "/api/v1/adopciones/(.*)",
      "destination": {
        "service": "api-adopciones"
      }
    },
    {
      "source": "/api/v1/adopciones",
      "destination": {
        "service": "api-adopciones"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
